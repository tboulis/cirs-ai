# Backend environment example for Docker Compose

# Absolute paths are not required inside containers. Compose overrides below as needed.
DATABASE_URL=sqlite:////data/cirs_llm.db
UPLOAD_DIR=/app/uploads
CHROMA_PERSIST_DIR=/app/chroma_db

# Security
SECRET_KEY=secret_key

# LLM provider settings (set one or both)
OPENAI_API_KEY=
DEFAULT_MODEL=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Optional domain description override
# DOMAIN_DESCRIPTION=

# Create the demo accounts lyra_1..lyra_5 on startup (local development only, see README)
SEED_DEMO_USERS=false
